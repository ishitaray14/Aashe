# Environment Variables for Aashe
# Copy this file to .env for local development

# PostgreSQL connection string (auto-provided by Render)
DATABASE_URL=postgresql://postgres:ishita@localhost:5432/aashe

# JWT signing secret (use a long random string in production)
JWT_SECRET=replace_with_a_very_long_random_secret_string

# Server port (Render sets this automatically)
PORT=3000

# Environment
NODE_ENV=development
